      "model": "PedigreeAminoAcidChangeType",
      "displayField": "change",
      "createFields": { "change": "Test Amino Acid Change" },
      "listSelector": "table tbody, .admin-list"
    },
    {
      "url": "/Genetics/gene",
      "listUrl": "/Genetics/gene/list",
